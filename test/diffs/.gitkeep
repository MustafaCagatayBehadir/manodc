<config xmlns="http://tail-f.com/ns/config/1.0">
  <dc-sites xmlns="http://turkcell.com/manodc">
    <dc-site>
      <location>AVR</location>
      <hall>NDC1</hall>
      <fabric>CONTROL</fabric>
      <eor>
        <name>AVR-NDC1-NFVC-EOR-SW-01</name>
        <role>primary</role>
      </eor>
      <eor>
        <name>AVR-NDC1-NFVC-EOR-SW-02</name>
        <role>secondary</role>
      </eor>
      <tor>
        <name>AVR-NDC1-NFVC-TOR-SW-01</name>
      </tor>
      <tor>
        <name>AVR-NDC1-NFVC-TOR-SW-02</name>
      </tor>
      <tor>
        <name>AVR-NDC1-NFVC-TOR-SW-03</name>
      </tor>
      <tor>
        <name>AVR-NDC1-NFVC-TOR-SW-04</name>
      </tor>
      <tor-group>
        <name>SW-01-02</name>
        <tor-1>AVR-NDC1-NFVC-TOR-SW-01</tor-1>
        <tor-2>AVR-NDC1-NFVC-TOR-SW-02</tor-2>
      </tor-group>
      <tor-group>
        <name>SW-03-04</name>
        <tor-1>AVR-NDC1-NFVC-TOR-SW-03</tor-1>
        <tor-2>AVR-NDC1-NFVC-TOR-SW-04</tor-2>
      </tor-group>
      <resource-pools>
        <vlan-id-pool>AVR_NDC1_CONTROL_VLAN_POOL</vlan-id-pool>
        <vrrpv3-id-pool>AVR_NDC1_CONTROL_VRRPV3_POOL</vrrpv3-id-pool>
      </resource-pools>
    </dc-site>
    <dc-site>
      <location>AVR</location>
      <hall>NDC1</hall>
      <fabric>DATA</fabric>
      <switch>
        <name>AVR-NDC1-NFVD-SW-01</name>
      </switch>
      <switch>
        <name>AVR-NDC1-NFVD-SW-02</name>
      </switch>
      <switch>
        <name>AVR-NDC1-NFVD-SW-03</name>
      </switch>
      <switch>
        <name>AVR-NDC1-NFVD-SW-04</name>
      </switch>
      <switch>
        <name>AVR-NDC1-NFVD-SW-05</name>
      </switch>
      <switch>
        <name>AVR-NDC1-NFVD-SW-06</name>
      </switch>
      <resource-pools>
        <vlan-id-pool>AVR_NDC1_DATA_VLAN_POOL</vlan-id-pool>
        <vrrpv3-id-pool>AVR_NDC1_DATA_VRRPV3_POOL</vrrpv3-id-pool>
      </resource-pools>
    </dc-site>
  </dc-sites>
</config>