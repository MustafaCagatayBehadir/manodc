cli-c {
    local-node {
        data devices device AVR-NDC1-NFVC-EOR-SW-01
               config
                feature vrrpv3
                feature interface-vlan
                vlan 1000
                 name Mavenir-vIMS::VLAN1000
                exit
                vrf context Tcell-GRT
                 address-family ipv4 unicast
                 exit
                 address-family ipv6 unicast
                 exit
                exit
                interface Vlan1000
                 no shutdown
                 description Mavenir-vIMS::VLAN1000
                 vrf member Tcell-GRT
                 ip address 10.141.14.2/29
                 mtu 9216
                 vrrpv3 1 address-family ipv4
                  address 10.141.14.1 primary
                  priority 110
                 exit
                exit
               !
              !
              devices device AVR-NDC1-NFVC-EOR-SW-02
               config
                feature vrrpv3
                feature interface-vlan
                vlan 1000
                 name Mavenir-vIMS::VLAN1000
                exit
                vrf context Tcell-GRT
                 address-family ipv4 unicast
                 exit
                 address-family ipv6 unicast
                 exit
                exit
                interface Vlan1000
                 no shutdown
                 description Mavenir-vIMS::VLAN1000
                 vrf member Tcell-GRT
                 ip address 10.141.14.3/29
                 mtu 9216
                 vrrpv3 1 address-family ipv4
                  address 10.141.14.1 primary
                  priority 100
                 exit
                exit
               !
              !
              devices device AVR-NDC1-NFVC-TOR-SW-01
               config
                vlan 1000
                 name Mavenir-vIMS::VLAN1000
                exit
                interface Ethernet1/1
                 switchport
                 switchport mode access
                 switchport access vlan 1000
                 no shutdown
                 description Mavenir-vIMS::avucpcpt81::p1p1
                 mtu 9216
                 spanning-tree bpduguard enable
                 spanning-tree port type edge
                exit
                interface Ethernet1/2
                 switchport
                 switchport mode access
                 switchport access vlan 1000
                 no shutdown
                 description Mavenir-vIMS::avucpcpt82::p1p1
                 mtu 9216
                 spanning-tree bpduguard enable
                 spanning-tree port type edge
                exit
               !
              !
              devices device AVR-NDC1-NFVC-TOR-SW-02
               config
                vlan 1000
                 name Mavenir-vIMS::VLAN1000
                exit
                interface Ethernet1/1
                 switchport
                 switchport mode access
                 switchport access vlan 1000
                 no shutdown
                 description Mavenir-vIMS::avucpcpt81::p2p1
                 mtu 9216
                 spanning-tree bpduguard enable
                 spanning-tree port type edge
                exit
                interface Ethernet1/2
                 switchport
                 switchport mode access
                 switchport access vlan 1000
                 no shutdown
                 description Mavenir-vIMS::avucpcpt82::p2p1
                 mtu 9216
                 spanning-tree bpduguard enable
                 spanning-tree port type edge
                exit
               !
              !
              resource-pools id-pool AVR_NDC1_CONTROL_VLAN_POOL
               allocation bridge-domains_bridge-domain-vlan_AVR-NDC1-CONTROL_Mavenir-vIMS_1000
                username admin
                allocating-service [ /manodc:bridge-domains/manodc:bridge-domain-vlan[manodc:site='AVR-NDC1-CONTROL'][manodc:name='Mavenir-vIMS'][manodc:vlan='1000'] ]
                redeploy-type default
                request sync false
                request id 1000
               !
              !
              resource-pools id-pool AVR_NDC1_CONTROL_VRRPV3_POOL
               allocation bridge-domains_bridge-domain-vlan_AVR-NDC1-CONTROL_Mavenir-vIMS_1000
                username admin
                allocating-service [ /manodc:bridge-domains/manodc:bridge-domain-vlan[manodc:site='AVR-NDC1-CONTROL'][manodc:name='Mavenir-vIMS'][manodc:vlan='1000'] ]
                redeploy-type default
                request sync false
               !
              !
              bridge-domains bridge-domain-vlan-switch AVR-NDC1-CONTROL Mavenir-vIMS 1000 AVR-NDC1-NFVC-EOR-SW-01
               layer3 vrf Tcell-GRT
               layer3 address 10.141.14.2/29
               layer3 vip-address 10.141.14.1/29
               layer3 vrrpv3-id 1
               layer3 vrrpv3-priority 110
              !
              bridge-domains bridge-domain-vlan-switch AVR-NDC1-CONTROL Mavenir-vIMS 1000 AVR-NDC1-NFVC-EOR-SW-02
               layer3 vrf Tcell-GRT
               layer3 address 10.141.14.3/29
               layer3 vip-address 10.141.14.1/29
               layer3 vrrpv3-id 1
               layer3 vrrpv3-priority 100
              !
              bridge-domains bridge-domain-vlan-switch AVR-NDC1-CONTROL Mavenir-vIMS 1000 AVR-NDC1-NFVC-TOR-SW-01
               port 1/1
                connected-host avucpcpt81
                host-port p1p1
                mode access
               !
               port 1/2
                connected-host avucpcpt82
                host-port p1p1
                mode access
               !
              !
              bridge-domains bridge-domain-vlan-switch AVR-NDC1-CONTROL Mavenir-vIMS 1000 AVR-NDC1-NFVC-TOR-SW-02
               port 1/1
                connected-host avucpcpt81
                host-port p2p1
                mode access
               !
               port 1/2
                connected-host avucpcpt82
                host-port p2p1
                mode access
               !
              !
              
    }
