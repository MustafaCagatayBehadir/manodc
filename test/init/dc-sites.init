<config xmlns="http://tail-f.com/ns/config/1.0">
  <inventory-manager xmlns="http://turkcell.com/inv">
    <name>AVR-NDC1-CONTROL</name>
    <site-configs>
      <validations>
        <subnet-validation>disable</subnet-validation>
      </validations>
      <global-site-parameters>
        <description>deneme</description>
        <city>deneme</city>
        <latitude>deneme</latitude>
        <longtitude>deneme</longtitude>
      </global-site-parameters>
      <device-site-parameters>
        <device-redundancy-group>
          <name>EOR-01-02</name>
        </device-redundancy-group>
      </device-site-parameters>
    </site-configs>
    <device>
      <name>AVR-NDC1-NFVC-EOR-SW-01</name>
      <device-role>EOR</device-role>
      <device-redundancy-group>EOR-01-02</device-redundancy-group>
    </device>
    <device>
      <name>AVR-NDC1-NFVC-EOR-SW-02</name>
      <device-role>EOR</device-role>
      <device-redundancy-group>EOR-01-02</device-redundancy-group>
    </device>
    <device>
      <name>AVR-NDC1-NFVC-TOR-SW-01</name>
      <device-role>TOR</device-role>
    </device>
    <device>
      <name>AVR-NDC1-NFVC-TOR-SW-02</name>
      <device-role>TOR</device-role>
    </device>
    <device>
      <name>AVR-NDC1-NFVC-TOR-SW-03</name>
      <device-role>TOR</device-role>
    </device>
    <device>
      <name>AVR-NDC1-NFVC-TOR-SW-04</name>
      <device-role>TOR</device-role>
    </device>
  </inventory-manager>
</config>